.s-product-attachments-section
  > .s-section-header
    &:not(:empty)
      margin-bottom 1.5rem

  .s-attachments-wrapper
    .s-attachments-list
      display table
      width 100%
      margin-top 1rem

      .s-attachments-wrapper
        display table-row

        &:nth-child(odd)
          background var(--background-color-zebra-row-odd)

        > *
          display table-cell
          padding 0.25rem 0.5rem

        .s-column-file
          width 100%

        .s-column-actions
          text-align right
          vertical-align middle

        .s-column-file-name
          margin 0.5rem 0 0.75rem

        .s-column-file-description
          margin 0.5rem 0
          font-size 0.875rem

          .s-column-file-description__content
            padding 0.25rem

            &:hover
              cursor text
              background-color #eed

          .s-column-file-description__editor
            .s-syrattach-editable-field
              margin-bottom 0.5rem


  .s-syrattach-upload-files
    margin 1.5rem 0
    display table

  .s-syrattach-uploading-file
    display table-row

    &__error
      background-color rgba(255,49,21,0.06)

  .s-syrattach-uploading-file__main, .s-syrattach-uploading-file__actions
    display table-cell

  .s-syrattach-uploading-file__main
    width 100%

  .s-syrattach-uploading-file__actions
    min-width 1em
    vertical-align middle
    padding 1rem

  .s-syrattach-uploading-file__error-text
    margin 0.5rem 0
    color var(--red)

  .s-syrattach-dismiss
    color var(--red)

  .s-syrattach-filesize-hint
    font-size 0.75rem
    color var(--text-color-hint)

  .s-drop-area
    position relative
    background var(--white)
    color var(--gray)
    transition: 200ms linear all;

    &.is-over
      background: var(--highlighted-yellow)

    &:not(.is-over):hover
      border-color: var(--highlighted-yellow)

    .s-field
      position absolute
      top 0
      left 0
      width 100%
      height 100%
      opacity 0
      background #888
      cursor pointer
      text-indent -9999px

    .s-text
      font-size 0.875rem
