msgid "Select files"
msgstr "Sélectionner des fichiers"

msgid "or drag them here to start upload"
msgstr "ou faites-les glisser ici pour lancer le téléversement"

msgid "Add file description"
msgstr "Ajouter une description du fichier"

msgid "Delete"
msgstr "Supprimer"

msgid "Max. file size for upload:"
msgstr "Taille maximale du fichier à téléverser :"

msgid "Attached Files Plugin Setup"
msgstr "Configuration du plugin « Fichiers joints »"

msgid "Save"
msgstr "Enregistrer"

msgid "Attached files"
msgstr "Fichiers joints"

msgid "Files other than images that may be useful to the buyer: instructions, certificates, etc."
msgstr "Fichiers autres que des images pouvant être utiles à l'acheteur : notices, certificats, etc."

msgid "Related files"
msgstr "Fichiers associés"

msgid "Recommended: add a file named"
msgstr "Recommandé : ajoutez un fichier nommé"

msgid "to your active design theme. The plugin will automatically use it instead of the built-in template."
msgstr "à votre thème de design actif. Le plugin l'utilisera automatiquement à la place du template intégré."

msgid "JFYI. Variables available within the template:"
msgstr "Pour information. Variables disponibles dans le template :"

msgid "A list of file data. Each file item is an array with keys:"
msgstr "Une liste de données de fichiers. Chaque élément est un tableau comportant les clés suivantes :"

msgid "Attachment ID#"
msgstr "ID"

msgid "File name"
msgstr "Nom du fichier"

msgid "File extension"
msgstr "Extension du fichier"

msgid "File description"
msgstr "Description du fichier"

msgid "File size in bytes"
msgstr "Taille du fichier en octets"

msgid "File URL"
msgstr "URL"

msgid "Template saved from previous version of plugin"
msgstr "Template enregistré dans une version précédente du plugin"

msgid "Transfer its code to"
msgstr "Transférez son code dans"

msgid "in your design theme, then"
msgstr "de votre thème de design, puis"

msgid "delete it from here"
msgstr "supprimez-le ici"

msgid "show"
msgstr "afficher"

msgid "Default template"
msgstr "Template par défaut"

msgid "Error deleting modified template"
msgstr "Erreur lors de la suppression du template personnalisé"

msgid "Do you really want to delete your custom template?"
msgstr "Voulez-vous vraiment supprimer votre template personnalisé ?"

msgid "Access denied"
msgstr "Accès refusé"

msgid "Attached Files Plugin Settings"
msgstr "Paramètres du plugin « Fichiers joints »"

msgid "Saved"
msgstr "Enregistré"

msgid "Product ID required"
msgstr "Identifiant du produit requis"

msgid "Errors"
msgstr "Erreurs"

msgid "Close"
msgstr "Fermer"

msgid "Deleted"
msgstr "Supprimé"

msgid "Unknown entity"
msgstr "Entité inconnue"

msgid "Unknown attachment ID"
msgstr "Identifiant de pièce jointe inconnu"

msgid "Description is not set"
msgstr "Aucune description renseignée"

msgid "Invalid parameters"
msgstr "Paramètres invalides"

msgid "File not found"
msgstr "Fichier introuvable"

msgid "Entity ID required"
msgstr "Identifiant de l'entité requis"

msgid "GB"
msgstr "Go"

msgid "MB"
msgstr "Mo"

msgid "KB"
msgstr "Ko"

msgid "bytes"
msgstr "octets"

msgid "of"
msgstr "sur"

msgid "Upload or drag & drop files here"
msgstr "Téléversez des fichiers ou faites-les glisser ici"

msgid "Loading files"
msgstr "Fichiers en cours de téléversement"

msgid "Cancel"
msgstr "Annuler"

msgid "File deletion confirmation"
msgstr "Confirmation de la suppression"

msgid "Do you really want to delete this file?"
msgstr "Voulez-vous vraiment supprimer ce fichier ?"

msgid "Size of %name% exceeds maximum upload size limit"
msgstr "La taille de %name% dépasse la taille maximale autorisée pour le téléversement"

msgid "Upload error"
msgstr "Erreur de téléversement"

msgid "Server error"
msgstr "Erreur du serveur"

msgid "Loading"
msgstr "Chargement"

msgid "Drag to reorder"
msgstr "Faites glisser pour réorganiser"

msgid "Attach existing file"
msgstr "Joindre un fichier existant"

msgid "Search by filename..."
msgstr "Rechercher par nom de fichier…"

msgid "Attach"
msgstr "Joindre"

msgid "No files found"
msgstr "Aucun fichier trouvé"

msgid "You can't upload files to a new product. First, save the product."
msgstr "Impossible de téléverser des fichiers vers un nouveau produit. Enregistrez d'abord le produit."

msgid "Attached Files"
msgstr "Fichiers joints"

msgid "Hook"
msgstr "Hook"

msgid "Hook name to display filelist. Each hook placement depends of theme design. <a href=\"http://www.webasyst.com/developers/docs/plugins/hooks/shop/frontend_product/\" target=\"_blank\">More info about hooks.</a>"
msgstr "Nom du hook où afficher la liste des fichiers. L'emplacement exact du hook dépend du thème de design. <a href=\"http://www.webasyst.com/developers/docs/plugins/hooks/shop/frontend_product/\" target=\"_blank\">En savoir plus sur les hooks.</a>"

msgid "No. Disable hooks"
msgstr "Non. Désactiver les hooks"

msgid "Storefront without template"
msgstr "Vitrine sans template"

msgid "Applies when the design theme used in the storefront does not contain <code>plugin.syrattach.attachments.html</code>"
msgstr "S'applique lorsque le thème de design utilisé par la vitrine ne contient pas le fichier <code>plugin.syrattach.attachments.html</code>"

msgid "Show default template"
msgstr "Afficher le template par défaut"

msgid "Switch off"
msgstr "Se désactiver"

msgid "Template"
msgstr "Template"

msgid "Template to display at the hook position. HTML+Smarty"
msgstr "Template à afficher à l'emplacement du hook. HTML et Smarty"

msgid "Database error"
msgstr "Erreur de base de données"

msgid "Database error creating file link"
msgstr "Erreur de base de données lors de la création du lien vers le fichier"

msgid "Entity ID missing while saving file"
msgstr "Identifiant de l'entité manquant lors de l'enregistrement du fichier"

msgid "Delete error"
msgstr "Erreur de suppression"

msgid "Error saving file: directory not writable."
msgstr "Erreur lors de l'enregistrement du fichier : le répertoire n'est pas accessible en écriture."

msgid "Error saving file: cannot create directory."
msgstr "Erreur lors de l'enregistrement du fichier : impossible de créer le répertoire."

msgid "Cannot find a link record ID#%d"
msgstr "Enregistrement de liaison ID#%d introuvable"

msgid "SyrAttach cannot delete file for record %d: %s"
msgstr "SyrAttach ne peut pas supprimer le fichier de l'enregistrement %d : %s"

msgid "SyrAttach cannot delete dir for file %d: %s"
msgstr "SyrAttach ne peut pas supprimer le répertoire du fichier %d : %s"

msgid "Attached File"
msgstr "Fichier joint"

msgid "No ID given for product \"%s\""
msgstr "Aucun identifiant (ID) indiqué pour le produit « %s »"

msgid "Wrong file name \"%s\" for product \"%s\". File not saved."
msgstr "Nom de fichier « %s » incorrect pour le produit « %s ». Fichier non enregistré."

msgid "File named \"%s\" not exists or not readable. File not saved."
msgstr "Le fichier « %s » n'existe pas ou n'est pas lisible. Fichier non enregistré."
