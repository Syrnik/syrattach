msgstr "Weet u zeker dat u dit bestand wilt verwijderen?"

msgid "Size of %name% exceeds maximum upload size limit"
msgstr "De grootte van %name% overschrijdt de maximaal toegestane uploadgrootte"

msgid "Upload error"
msgstr "Uploadfout"

msgid "Server error"
msgstr "Serverfout"

msgid "Loading"
msgstr "Bezig met laden"

msgid "Drag to reorder"
msgstr "Sleep om de volgorde te wijzigen"

msgid "Attach existing file"
msgstr "Bestaand bestand koppelen"

msgid "Search by filename..."
msgstr "Zoeken op bestandsnaam…"

msgid "Attach"
msgstr "Koppelen"

msgid "No files found"
msgstr "Geen bestanden gevonden"

msgid "You can't upload files to a new product. First, save the product."
msgstr "U kunt geen bestanden uploaden naar een nieuw product. Sla het product eerst op."

msgid "Attached Files"
msgstr "Bijgevoegde bestanden"

msgid "Hook"
msgstr "Hook"

msgid "Hook name to display filelist. Each hook placement depends of theme design. <a href=\"http://www.webasyst.com/developers/docs/plugins/hooks/shop/frontend_product/\" target=\"_blank\">More info about hooks.</a>"
msgstr "Naam van de hook waar de bestandslijst wordt weergegeven. De exacte positie van de hook hangt af van het ontwerpthema. <a href=\"http://www.webasyst.com/developers/docs/plugins/hooks/shop/frontend_product/\" target=\"_blank\">Meer over hooks.</a>"

msgid "No. Disable hooks"
msgstr "Nee. Hooks uitschakelen"

msgid "Storefront without template"
msgstr "Storefront zonder sjabloon"

msgid "Applies when the design theme used in the storefront does not contain <code>plugin.syrattach.attachments.html</code>"
msgstr "Van toepassing wanneer het ontwerpthema van de storefront geen bestand <code>plugin.syrattach.attachments.html</code> bevat"

msgid "Show default template"
msgstr "Standaardsjabloon tonen"

msgid "Switch off"
msgstr "Uitschakelen"

msgid "Template"
msgstr "Sjabloon"

msgid "Template to display at the hook position. HTML+Smarty"
msgstr "Sjabloon dat op de hookpositie wordt weergegeven. HTML en Smarty"

msgid "Database error"
msgstr "Databasefout"

msgid "Database error creating file link"
msgstr "Databasefout bij het aanmaken van de bestandskoppeling"

msgid "Entity ID missing while saving file"
msgstr "Entiteits-ID ontbreekt bij het opslaan van het bestand"

msgid "Delete error"
msgstr "Fout bij verwijderen"

msgid "Error saving file: directory not writable."
msgstr "Fout bij opslaan van bestand: map is niet beschrijfbaar."

msgid "Error saving file: cannot create directory."
msgstr "Fout bij opslaan van bestand: map kan niet worden aangemaakt."

msgid "Cannot find a link record ID#%d"
msgstr "Koppelingsrecord ID#%d niet gevonden"

msgid "SyrAttach cannot delete file for record %d: %s"
msgstr "SyrAttach kan het bestand voor record %d niet verwijderen: %s"

msgid "SyrAttach cannot delete dir for file %d: %s"
msgstr "SyrAttach kan de map voor bestand %d niet verwijderen: %s"

msgid "Attached File"
msgstr "Bijgevoegd bestand"

msgid "No ID given for product \"%s\""
msgstr "Geen ID opgegeven voor product ‘%s’"

msgid "Wrong file name \"%s\" for product \"%s\". File not saved."
msgstr "Ongeldige bestandsnaam ‘%s’ voor product ‘%s’. Bestand niet opgeslagen."

msgid "File named \"%s\" not exists or not readable. File not saved."
msgstr "Het bestand ‘%s’ bestaat niet of is niet leesbaar. Bestand niet opgeslagen."
