msgstr "Opgeslagen"

msgid "Product ID required"
msgstr "Product-ID vereist"

msgid "Errors"
msgstr "Fouten"

msgid "Close"
msgstr "Sluiten"

msgid "Deleted"
msgstr "Verwijderd"

msgid "Unknown entity"
msgstr "Onbekende entiteit"

msgid "Unknown attachment ID"
msgstr "Onbekende bijlage-ID"

msgid "Description is not set"
msgstr "Geen omschrijving opgegeven"

msgid "Invalid parameters"
msgstr "Ongeldige parameters"

msgid "File not found"
msgstr "Bestand niet gevonden"

msgid "Entity ID required"
msgstr "Entiteits-ID vereist"

msgid "GB"
msgstr "GB"

msgid "MB"
msgstr "MB"

msgid "KB"
msgstr "KB"

msgid "bytes"
msgstr "bytes"

msgid "of"
msgstr "van"

msgid "Upload or drag & drop files here"
msgstr "Upload bestanden of sleep ze hierheen"

