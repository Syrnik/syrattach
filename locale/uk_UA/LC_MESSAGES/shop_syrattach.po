msgid "Select files"
msgstr "Виберіть файли"

msgid "or drag them here to start upload"
msgstr "або перетягніть їх сюди, щоб почати завантаження"

msgid "Add file description"
msgstr "Додати опис файлу"

msgid "Delete"
msgstr "Видалити"

msgid "Max. file size for upload:"
msgstr "Максимальний розмір файлу для завантаження:"

msgid "Attached Files Plugin Setup"
msgstr "Налаштування плагіна «Прикріплені файли»"

msgid "Save"
msgstr "Зберегти"

msgid "Attached files"
msgstr "Прикріплені файли"

msgid "Files other than images that may be useful to the buyer: instructions, certificates, etc."
msgstr "Файли, крім зображень, які можуть бути корисні покупцеві: інструкції, сертифікати тощо."

msgid "Related files"
msgstr "Супутні файли"

msgid "Recommended: add a file named"
msgstr "Рекомендовано: додайте файл з ім'ям"

msgid "to your active design theme. The plugin will automatically use it instead of the built-in template."
msgstr "до активної теми дизайну. Плагін автоматично використає його замість вбудованого шаблона."

msgid "JFYI. Variables available within the template:"
msgstr "Для довідки. Змінні, доступні в шаблоні:"

msgid "A list of file data. Each file item is an array with keys:"
msgstr "Список даних про файли. Кожен запис про файл є масивом із такими ключами:"

msgid "Attachment ID#"
msgstr "ID"

msgid "File name"
msgstr "Ім'я файлу"

msgid "File extension"
msgstr "Розширення файлу"

msgid "File description"
msgstr "Опис файлу"

msgid "File size in bytes"
msgstr "Розмір файлу в байтах"

msgid "File URL"
msgstr "URL"

msgid "Template saved from previous version of plugin"
msgstr "Шаблон, збережений у попередній версії плагіна"

msgid "Transfer its code to"
msgstr "Перенесіть його код у"

msgid "in your design theme, then"
msgstr "у темі дизайну, потім"

msgid "delete it from here"
msgstr "видаліть цей код тут"

msgid "show"
msgstr "показати"

msgid "Default template"
msgstr "Шаблон за замовчуванням"

msgid "Error deleting modified template"
msgstr "Помилка видалення користувацького шаблона"

msgid "Do you really want to delete your custom template?"
msgstr "Ви справді хочете видалити шаблон?"

msgid "Access denied"
msgstr "Доступ заборонено"

msgid "Attached Files Plugin Settings"
msgstr "Налаштування плагіна «Прикріплені файли»"

msgid "Saved"
msgstr "Збережено"

msgid "Product ID required"
msgstr "Потрібен ID товару"

msgid "Errors"
msgstr "Помилки"

msgid "Close"
msgstr "Закрити"

msgid "Deleted"
msgstr "Видалено"

msgid "Unknown entity"
msgstr "Невідома сутність"

msgid "Unknown attachment ID"
msgstr "Невідомий ідентифікатор вкладення"

msgid "Description is not set"
msgstr "Опис не задано"

msgid "Invalid parameters"
msgstr "Невірні параметри"

msgid "File not found"
msgstr "Файл не знайдено"

msgid "Entity ID required"
msgstr "Не вказано ідентифікатор об'єкта"

msgid "GB"
msgstr "ГБ"

msgid "MB"
msgstr "МБ"

msgid "KB"
msgstr "КБ"

msgid "bytes"
msgstr "байт"

msgid "of"
msgstr "з"

msgid "Upload or drag & drop files here"
msgstr "Завантажте або перетягніть файли сюди"

msgid "Loading files"
msgstr "Файли, що завантажуються"

msgid "Cancel"
msgstr "Скасувати"

msgid "File deletion confirmation"
msgstr "Підтвердження видалення"

msgid "Do you really want to delete this file?"
msgstr "Ви справді хочете видалити цей файл?"

msgid "Size of %name% exceeds maximum upload size limit"
msgstr "Розмір файлу %name% перевищує максимально допустимий розмір для завантаження"

msgid "Upload error"
msgstr "Помилка завантаження"

msgid "Server error"
msgstr "Помилка сервера"

msgid "Loading"
msgstr "Завантаження"

msgid "Drag to reorder"
msgstr "Перетягніть, щоб змінити порядок"

msgid "Attach existing file"
msgstr "Прикріпити наявний файл"

msgid "Search by filename..."
msgstr "Пошук за ім'ям файлу..."

msgid "Attach"
msgstr "Прикріпити"

msgid "No files found"
msgstr "Файлів не знайдено"

msgid "You can't upload files to a new product. First, save the product."
msgstr "До нового товару не можна завантажити файли. Спочатку збережіть товар."

msgid "Attached Files"
msgstr "Прикріплені файли"

msgid "Hook"
msgstr "Хук"

msgid "Hook name to display filelist. Each hook placement depends of theme design. <a href=\"http://www.webasyst.com/developers/docs/plugins/hooks/shop/frontend_product/\" target=\"_blank\">More info about hooks.</a>"
msgstr "Назва хука для показу списку файлів. Конкретне місце розташування хука залежить від теми дизайну. <a href=\"http://www.webasyst.com/developers/docs/plugins/hooks/shop/frontend_product/\" target=\"_blank\">Докладніше про хуки.</a>"

msgid "No. Disable hooks"
msgstr "Ні. Заборонити хуки"

msgid "Storefront without template"
msgstr "Вітрина без шаблона"

msgid "Applies when the design theme used in the storefront does not contain <code>plugin.syrattach.attachments.html</code>"
msgstr "Застосовується, коли в темі дизайну на вітрині немає файлу <code>plugin.syrattach.attachments.html</code>"

msgid "Show default template"
msgstr "Показати шаблон за замовчуванням"

msgid "Switch off"
msgstr "Вимкнутися"

msgid "Template"
msgstr "Шаблон"

msgid "Template to display at the hook position. HTML+Smarty"
msgstr "Шаблон для відображення у вибраному хуці. HTML і Smarty"

msgid "Database error"
msgstr "Помилка бази даних"

msgid "Database error creating file link"
msgstr "Помилка бази даних під час створення зв'язку з файлом"

msgid "Entity ID missing while saving file"
msgstr "Під час збереження файлу не вказано ідентифікатор об'єкта"

msgid "Delete error"
msgstr "Помилка видалення"

msgid "Error saving file: directory not writable."
msgstr "Помилка збереження файлу: каталог недоступний для запису."

msgid "Error saving file: cannot create directory."
msgstr "Помилка збереження файлу: не вдалося створити каталог."

msgid "Cannot find a link record ID#%d"
msgstr "Не знайдено запис зв'язку ID#%d"

msgid "SyrAttach cannot delete file for record %d: %s"
msgstr "SyrAttach не може видалити файл для запису %d: %s"

msgid "SyrAttach cannot delete dir for file %d: %s"
msgstr "SyrAttach не може видалити каталог для файлу %d: %s"

msgid "Attached File"
msgstr "Прикріплений файл"

msgid "No ID given for product \"%s\""
msgstr "Не вказано ідентифікатор (ID) для товару «%s»"

msgid "Wrong file name \"%s\" for product \"%s\". File not saved."
msgstr "Невірне ім'я файлу «%s» для товару «%s». Файл не збережено."

msgid "File named \"%s\" not exists or not readable. File not saved."
msgstr "Файл «%s» не існує або недоступний для читання. Файл не збережено."
